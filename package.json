{
  "name": "nist-cve-checker",
  "version": "1.0.0",
  "description": "Query NIST NVD CVE API for installed software vulnerabilities",
  "main": "scripts/cve-checker.js",
  "scripts": {
    "start": "node scripts/cve-checker.js -1 HIGH -1",
    "check": "node scripts/cve-checker.js -1 HIGH 5",
    "test": "node --test \"scripts/test/*.test.js\"",
    "bundle": "node scripts/build.js",
    "preweb": "node scripts/build.js",
    "web": "node scripts/web-server.js",
    "sync-mitre": "node scripts/mitre-sync.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  }
}
