    {
      "cve": {
        "id": "CVE-2026-113722",
        "sourceIdentifier": "security-advisories@github.com",
        "published": "2026-10-20T20:17:18.810",
        "lastModified": "2026-10-23T02:16:57.087",
        "vulnStatus": "Undergoing Analysis",
        "cveTags": [],
        "descriptions": [
          {
            "lang": "en",
            "value": "virtualenv is a tool for creating isolated virtual python environments. Prior to 21.14.9, virtualenv's ScriptMakerCustom and pip pass an incompletely quoted interpreter path to distlib ScriptMaker when generating POSIX console scripts. When the path contains a space or produces a shebang longer than 127 bytes, distlib emits a /bin/sh wrapper whose double-quoted interpreter path still expands command substitutions and backticks. An attacker who influences the environment destination can therefore execute commands with the user's privileges when the user later runs a generated launcher; environment creation and activation do not trigger the command. Existing launchers are not repaired by upgrading virtualenv alone and must be regenerated, while a later independent pip installation or upgrade can reintroduce an affected launcher because pip's vendored distlib is unchanged. The virtualenv fix is released in version 21.14.9."
          }
        ],
        "affected": [
