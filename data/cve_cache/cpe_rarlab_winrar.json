    {
      "cve": {
        "id": "CVE-2025-52331",
        "sourceIdentifier": "cve@mitre.org",
        "published": "2025-11-12T17:15:37.733",
        "lastModified": "2026-06-17T09:36:23.350",
        "vulnStatus": "Analyzed",
        "cveTags": [],
        "descriptions": [
          {
            "lang": "en",
            "value": "Cross-site scripting (XSS) vulnerability in the generate report functionality in Rarlab WinRAR 7.11, allows attackers to disclose user information such as the computer username, generated report directory, and IP address. The generate report command includes archived file names without validation in the HTML report, which allows potentially malicious HTML tags to be injected into the report. User interaction is required. User must use the \"generate report\" functionality and open the report."
          }
        ],
