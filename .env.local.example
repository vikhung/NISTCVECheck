# ── NIST NVD API ──────────────────────────────────────────────────────────────
# 申請：https://nvd.nist.gov/developers/request-an-api-key
# 未設定時仍可運作，但速率限制較嚴（每次請求間隔 6.5 秒，有 Key 則為 0.7 秒）
NIST_API_KEY=your-api-key-here

# ── 每個軟體最多取回的 CVE 筆數 ─────────────────────────────────────────────
# NVD API 每次查詢最多回傳幾筆 CVE（預設 50）
# 數值越高越完整，但每次查詢的回應時間也略增
MAX_CVES_PER_SOFTWARE=50

# ── Portable 功能總開關 ──────────────────────────────────────────────────────
# true  = 啟用 Portable 功能（預設值）
# false = 完全停用：即使設定了 PORTABLE_N 清單，也不會掃描；Web 介面亦隱藏輸入區塊
PORTABLE_ENABLE=true

# ── 掃描模式 ─────────────────────────────────────────────────────────────────
# true  = 只掃描 PORTABLE_N 定義的軟體，略過 Registry / JSON 檔案中的項目
# false = 掃描全部（Registry/JSON + Portable），預設值
# 注意：PORTABLE_ENABLE=false 時此設定無效
PORTABLE_ONLY=false

# ── 白名單（Whitelist）────────────────────────────────────────────────────────
# 逗號分隔的廠牌關鍵字，不分大小寫部分比對 publisher 欄位
# 符合的軟體將略過 NVD 查詢（視為安全，不列入報表）
# 亦可沿用 whitelist.txt（兩者並存時自動合併去重，env 優先）
WHITELIST=Microsoft,Apple,Google

# ── 免安裝 / 未登錄軟體（Portable Software）──────────────────────────────────
# 格式：PORTABLE_N=軟體名稱|版本|發行商
# - 版本（第 2 欄）與發行商（第 3 欄）可省略，留空即可
# - 編號必須從 0 開始連續，遇到第一個缺口即停止讀取
# - 這些項目會跳過白名單與 SKIP_PATTERNS，直接納入 NVD 掃描
# - PORTABLE_4=Your Software|1.0.0|Vendor Name
PORTABLE_0=Eclipse IDE|202506|Eclipse Foundation
PORTABLE_1=Apache Maven|3.8.6|Apache Software Foundation
PORTABLE_2=Node.js|24.15.0|OpenJS Foundation
PORTABLE_3=Neo4j Community Edition|2025.05.0|Neo4j Inc