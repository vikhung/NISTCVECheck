# ── CVE 資料來源 ──────────────────────────────────────────────────────────────
# NIST  = 預設值，即時查詢 services.nvd.nist.gov（需網路連線，偶有速率限制/逾時）
# MITRE = 改用本機 MITRE cvelistV5 鏡像，須先執行 npm run sync-mitre 建立索引
#         （索引不存在時，CLI/Web 啟動會立即報錯並提示執行 sync-mitre，不會自動改用 NIST）
CVE_SOURCE=NIST

# ── Proxy（公司/企業環境）────────────────────────────────────────────────────
# 若連線 services.nvd.nist.gov 需透過 Proxy，設定此項（擇一即可）
# HTTPS_PROXY=http://proxy.company.com:8080
# HTTP_PROXY=http://proxy.company.com:8080
# 支援需要驗證的 Proxy：http://user:password@proxy.company.com:8080
# 留空或不設定 = 直接連線
#
# 若 Proxy 有做 SSL Inspection（自簽憑證），連線很快但一直失敗時請設定：
# PROXY_SKIP_TLS_VERIFY=true

# ── NIST NVD API ──────────────────────────────────────────────────────────────
# 申請：https://nvd.nist.gov/developers/request-an-api-key
# 未設定時仍可運作，但速率限制較嚴（每次請求間隔 6.5 秒，有 Key 則為 0.7 秒）
NIST_API_KEY=your-api-key-here

# ── Log 詳細程度 ─────────────────────────────────────────────────────────────
# INFO  = 預設值，不顯示 curl 等除錯用 log
# DEBUG = 顯示完整除錯軌跡，目前包含：向 NVD 發出的完整 curl 查詢指令
LOG_LEVEL=INFO

# ── Portable 功能總開關 ──────────────────────────────────────────────────────
# true  = 啟用 Portable 功能（預設值）
# false = 完全停用：即使設定了 PORTABLE_N 清單，也不會掃描；Web 介面亦隱藏輸入區塊
PORTABLE_ENABLE=true

# ── 掃描模式 ─────────────────────────────────────────────────────────────────
# true  = 只掃描 PORTABLE_N 定義的軟體，略過 Registry / JSON 檔案中的項目
# false = 掃描全部（Registry/JSON + Portable），預設值
# 注意：PORTABLE_ENABLE=false 時此設定無效
PORTABLE_ONLY=false

# ── 白名單（Whitelist）────────────────────────────────────────────────────────
# 逗號分隔的廠牌關鍵字，不分大小寫部分比對 publisher 欄位
# 符合的軟體將略過 NVD 查詢（視為安全，不列入報表）
# 亦可沿用 whitelist.txt（兩者並存時自動合併去重，env 優先）
WHITELIST=Microsoft,Apple,Google

# ── 免安裝 / 未登錄軟體（Portable Software）──────────────────────────────────
# 格式：PORTABLE_N=軟體名稱|版本|發行商
# - 版本（第 2 欄）與發行商（第 3 欄）可省略，留空即可
# - 編號必須從 0 開始連續，遇到第一個缺口即停止讀取
# - 這些項目會跳過白名單與 SKIP_PATTERNS，直接納入 NVD 掃描
# - PORTABLE_4=Your Software|1.0.0|Vendor Name
PORTABLE_0=Eclipse IDE|202506|Eclipse Foundation
PORTABLE_1=Apache Maven|3.8.6|Apache Software Foundation
PORTABLE_2=Node.js|24.15.0|OpenJS Foundation
PORTABLE_3=Neo4j Community Edition|2025.05.0|Neo4j Inc

# ── 通用知名軟體的「標準 CPE base」對照 ──────────────────────────────────────
# 格式：CPE_BASE_N=軟體名稱|vendor:product[|vendor:product...]
# - 名稱比對「清理後的軟體名」（不分大小寫）；可列多個 vendor:product（| 分隔，OR 邏輯）
# - 用途：Python/Git 等「過於通用」的軟體，CPE 字典查詢會命中上萬筆而被判定過於通用 →
#   退化成關鍵字搜尋（描述沒提到產品名就漏、提到別產品就誤報）。預先指定其標準 CPE base，
#   即可跳過字典查詢、直接以 virtualMatchString 精準查 CVE（不受描述用字影響）。
# - 編號必須從 0 開始連續，遇到第一個缺口即停止讀取
#CPE_BASE_0=python|python:python
#CPE_BASE_1=git|git-scm:git|git:git
#CPE_BASE_2=node.js|nodejs:node.js